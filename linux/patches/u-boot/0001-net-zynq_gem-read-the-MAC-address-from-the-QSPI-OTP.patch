From: PYNQ-Z2 board notes
Subject: [PATCH] net: zynq_gem: read the MAC address from the QSPI OTP area

The TUL PYNQ-Z2 has no EEPROM for its MAC address. Its address is in the
OTP area of the QSPI flash (S25FL128S), at offset 0x20. Without it, U-Boot
makes a random address at each boot.

Add read_rom_hwaddr to zynq_gem, which calls the weak board function
zynq_board_read_rom_ethaddr(). With CONFIG_ZYNQ_QSPI_OTP_MAC, the Zynq board
code implements it with the OTP Read command (0x4B) of the flash. The OTP
area is only read. An address in the device tree or in the environment
still takes precedence.

Tested on a TUL PYNQ-Z2 with U-Boot v2026.10.
---
diff --git a/arch/arm/mach-zynq/include/mach/sys_proto.h b/arch/arm/mach-zynq/include/mach/sys_proto.h
index 268ec50a..8bb0777e 100644
--- a/arch/arm/mach-zynq/include/mach/sys_proto.h
+++ b/arch/arm/mach-zynq/include/mach/sys_proto.h
@@ -17,4 +17,7 @@ extern int zynq_slcr_get_mio_pin_status(const char *periph);
 extern void zynq_ddrc_init(void);
 extern unsigned int zynq_get_silicon_version(void);
 
+/* The MAC address of GEM0 from the storage of the board; 0 if found. */
+int zynq_board_read_rom_ethaddr(unsigned char *ethaddr);
+
 #endif /* _SYS_PROTO_H_ */
diff --git a/board/xilinx/zynq/Kconfig b/board/xilinx/zynq/Kconfig
index d6f40631..2917c1a8 100644
--- a/board/xilinx/zynq/Kconfig
+++ b/board/xilinx/zynq/Kconfig
@@ -18,6 +18,20 @@ config CMD_ZYNQ_AES
 	  Decrypts the encrypted image present in source address
 	  and places the decrypted image at destination address.
 
+config ZYNQ_QSPI_OTP_MAC
+	bool "Read the Ethernet MAC address from the OTP area of the QSPI flash"
+	depends on DM_SPI_FLASH && SPI_MEM && ZYNQ_GEM
+	help
+	  Reads the MAC address of GEM0 from the OTP area of the QSPI flash
+	  with the OTP Read command (0x4B) of Spansion/Cypress flash, for
+	  example the S25FL128S. The TUL PYNQ-Z2 has its address there. A MAC
+	  address in the device tree or in the environment takes precedence.
+
+config ZYNQ_QSPI_OTP_MAC_OFFSET
+	hex "Offset of the MAC address in the OTP area"
+	depends on ZYNQ_QSPI_OTP_MAC
+	default 0x20
+
 config CMD_ZYNQ_RSA
 	bool "Enable zynq rsa command for loading secure images"
 	default y
diff --git a/board/xilinx/zynq/Makefile b/board/xilinx/zynq/Makefile
index 8feaae39..3761ca6a 100644
--- a/board/xilinx/zynq/Makefile
+++ b/board/xilinx/zynq/Makefile
@@ -33,6 +33,7 @@ endif
 
 ifndef CONFIG_XPL_BUILD
 obj-$(CONFIG_CMD_ZYNQ) += cmds.o
+obj-$(CONFIG_ZYNQ_QSPI_OTP_MAC) += otp_mac.o
 obj-$(CONFIG_CMD_ZYNQ_RSA) += bootimg.o
 endif
 
diff --git a/board/xilinx/zynq/otp_mac.c b/board/xilinx/zynq/otp_mac.c
new file mode 100644
index 00000000..aeaa19e0
--- /dev/null
+++ b/board/xilinx/zynq/otp_mac.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Reads the MAC address of the board from the OTP area of a Spansion/Cypress
+ * QSPI flash (OTP Read, opcode 0x4B), as the PYNQ-Z2 stores it. The OTP area
+ * is only read here.
+ */
+
+#include <dm.h>
+#include <net.h>
+#include <spi.h>
+#include <spi-mem.h>
+#include <spi_flash.h>
+#include <asm/arch/sys_proto.h>
+#include <linux/errno.h>
+
+#define SPINOR_OP_OTPR	0x4b
+
+int zynq_board_read_rom_ethaddr(unsigned char *ethaddr)
+{
+	struct spi_mem_op op = SPI_MEM_OP(SPI_MEM_OP_CMD(SPINOR_OP_OTPR, 1),
+					  SPI_MEM_OP_ADDR(3, CONFIG_ZYNQ_QSPI_OTP_MAC_OFFSET, 1),
+					  SPI_MEM_OP_DUMMY(1, 1),
+					  SPI_MEM_OP_DATA_IN(ARP_HLEN, ethaddr, 1));
+	struct spi_flash *flash;
+	struct udevice *dev;
+	int ret;
+
+	ret = spi_flash_probe_bus_cs(CONFIG_SF_DEFAULT_BUS, CONFIG_SF_DEFAULT_CS, &dev);
+	if (ret)
+		return ret;
+	flash = dev_get_uclass_priv(dev);
+
+	ret = spi_claim_bus(flash->spi);
+	if (ret)
+		return ret;
+	ret = spi_mem_exec_op(flash->spi, &op);
+	spi_release_bus(flash->spi);
+	if (ret)
+		return ret;
+
+	/* An erased OTP area reads 0xff: that is not a valid address. */
+	if (!is_valid_ethaddr(ethaddr))
+		return -ENOENT;
+
+	return 0;
+}
diff --git a/drivers/net/zynq_gem.c b/drivers/net/zynq_gem.c
index f570ae9e..c6a210d7 100644
--- a/drivers/net/zynq_gem.c
+++ b/drivers/net/zynq_gem.c
@@ -1059,6 +1059,19 @@ static int zynq_gem_remove(struct udevice *dev)
 	return 0;
 }
 
+/* A board can give the MAC address from its own storage. */
+__weak int zynq_board_read_rom_ethaddr(unsigned char *ethaddr)
+{
+	return -ENOSYS;
+}
+
+static int zynq_gem_read_rom_mac(struct udevice *dev)
+{
+	struct eth_pdata *pdata = dev_get_plat(dev);
+
+	return zynq_board_read_rom_ethaddr(pdata->enetaddr);
+}
+
 static const struct eth_ops zynq_gem_ops = {
 	.start			= zynq_gem_init,
 	.send			= zynq_gem_send,
@@ -1066,6 +1079,7 @@ static const struct eth_ops zynq_gem_ops = {
 	.free_pkt		= zynq_gem_free_pkt,
 	.stop			= zynq_gem_halt,
 	.write_hwaddr		= zynq_gem_setup_mac,
+	.read_rom_hwaddr	= zynq_gem_read_rom_mac,
 };
 
 static int zynq_gem_of_to_plat(struct udevice *dev)
