# Kernel configuration fragment for the PYNQ-Z2, on top of multi_v7_defconfig (build-kernel.sh).
# The drivers that the board needs to boot from the card are built in; the rest are modules.
CONFIG_LOCALVERSION="-pynq-z2"
CONFIG_ARCH_ZYNQ=y
# PS peripherals (docs/ps.md)
CONFIG_SERIAL_XILINX_PS_UART=y
CONFIG_SERIAL_XILINX_PS_UART_CONSOLE=y
CONFIG_MACB=y
CONFIG_REALTEK_PHY=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_SPI_ZYNQ_QSPI=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_ULPI=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_STORAGE=m
# A module: with SCL held low (no pull-up, or QEMU), its probe waits for about 18 s.
CONFIG_I2C_GPIO=m
CONFIG_I2C_CHARDEV=y
CONFIG_GPIO_ZYNQ=y
# XADC, the PL manager and overlays for PL designs
CONFIG_XILINX_XADC=y
CONFIG_FPGA=y
CONFIG_FPGA_MGR_ZYNQ_FPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y
CONFIG_OF_OVERLAY=y
# Built in, so that uio_pdrv_genirq.of_id= of the command line applies (docs/pl-interface.md).
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
CONFIG_UIO_DMEM_GENIRQ=m
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
# The CPU stays at 650 MHz. Both operating points have the same voltage: no regulator in the device tree.
# The governor ondemand can still select 325 MHz.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# The root file system (Alpine Linux on F2FS on the card)
CONFIG_F2FS_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# mdev of Alpine sets /proc/sys/kernel/hotplug.
CONFIG_UEVENT_HELPER=y
